import 'dart:convert';
import 'dart:io';
import 'dart:ui' as ui;
import 'package:flutter/material.dart';
import 'package:flutter/foundation.dart';
import 'package:flutter/rendering.dart';
import 'package:flutter/services.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:APP_PACKAGE/main.dart';
import 'package:APP_PACKAGE/data/store.dart';
import 'package:APP_PACKAGE/screens/gallery.dart';

void main(){
  testWidgets('isolated af036f0 visual audit - no Firebase connection',(tester)async{
    tester.view.physicalSize=const Size(390,844);tester.view.devicePixelRatio=1;
    addTearDown(tester.view.resetPhysicalSize);addTearDown(tester.view.resetDevicePixelRatio);
    debugDefaultTargetPlatformOverride=TargetPlatform.iOS;
    addTearDown(()=>debugDefaultTargetPlatformOverride=null);
    for(final family in ['Roboto','packages/washkrew_ui/Roboto']){
      final font=FontLoader(family);
      for(final name in ['Regular','Medium','SemiBold','Bold'])font.addFont(rootBundle.load('packages/washkrew_ui/lib/fonts/Roboto-$name.ttf'));
      await font.load();
    }
    await (FontLoader('MaterialIcons')..addFont(rootBundle.load('fonts/MaterialIcons-Regular.otf'))).load();
    final out=Directory(const String.fromEnvironment('DESIGN_AUDIT_OUT'));
    await tester.runAsync(()=>out.create(recursive:true));
    final report=<Map<String,dynamic>>[];
    final ids=<String>[CASE_IDS];
    for(final id in ids){
      final errors=<String>[];
      void drain(){for(Object? e;(e=tester.takeException())!=null;)errors.add(e.toString().split('\n').take(3).join(' '));}
      try{
        await tester.pumpWidget(const SizedBox());await tester.pump();drain();
        final capture=GlobalKey();
        await tester.pumpWidget(RepaintBoundary(key:capture,child:const APP_WIDGET()));
        await tester.pump(const Duration(milliseconds:100));drain();
        await tester.runAsync(()=>precacheImage(const AssetImage('lib/brand/lockup_light.png',package:'washkrew_ui'),tester.element(find.byType(MaterialApp))));
        final scope=APP_SCOPE.of(tester.element(find.byType(MaterialApp)));
        final store=scope.store,router=scope.router;
        OPEN_CASE
        await tester.pump();await tester.pump(Duration(milliseconds:id=='C01'?200:800));
        if(id!='C01')await tester.pump(const Duration(milliseconds:450));drain();
        final boundary=capture.currentContext!.findRenderObject()! as RenderRepaintBoundary;
        await tester.runAsync(()async{
          final image=await boundary.toImage(pixelRatio:1);
          final bytes=await image.toByteData(format:ui.ImageByteFormat.png);
          await File('${out.path}/$id.png').writeAsBytes(bytes!.buffer.asUint8List());image.dispose();
        });
        report.add({'id':id,'captured':true,'errors':errors});
        AFTER_CASE
      }catch(e){report.add({'id':id,'captured':false,'errors':[...errors,e.toString()]});}
    }
    await tester.pumpWidget(const SizedBox());await tester.pump();
    for(Object? e;(e=tester.takeException())!=null;){}
    await tester.pump(const Duration(minutes:5));
    for(Object? e;(e=tester.takeException())!=null;){}
    await tester.runAsync(()=>File('${out.path}/manifest.json').writeAsString(const JsonEncoder.withIndent('  ').convert(report)));
    debugDefaultTargetPlatformOverride=null;
    print('VISUAL AUDIT: ${report.where((r)=>r['captured']==true).length}/${ids.length} states captured. No production backend or account.');
  },timeout:const Timeout(Duration(minutes:12)));
}