# Copy to .env.local and fill in the values before using authentication or the database.
# Pooled Neon connection used by the app and current migration configuration.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
# Direct Neon connection; available for tools that require an unpooled connection.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"
