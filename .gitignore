# Flutter / Dart
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
*.iml
.idea/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Generated.xcconfig
**/android/local.properties

# Secrets: copy env/dev.example.json to env/dev.json and fill it in
**/env/*.json
!**/env/*.example.json
backend/supabase/.env
supabase/.temp/
.DS_Store

# Xcode build output and per-user Xcode state (not source)
**/DerivedData/
**/.derived-data-log-*
**/xcuserdata/
*.xcuserstate

# Local caches
.cache/

# Next.js / Node
node_modules/
.next/
.open-next/
.wrangler/
out/
.pnpm-store/
*.tsbuildinfo
.env*
!.env.example
.dev.vars
!.dev.vars.example

# Firebase runtime output and local build settings
.firebase/
*-debug.log
firestore-debug.log
ui-debug.log
firebase.local.json
.secret.local
apps/flutter/**/env/firebase.json

# App lockfiles are tracked for reproducible releases.
!apps/flutter/customer/pubspec.lock
!apps/flutter/captain/pubspec.lock

# Downloaded, checksum-verified private photo service models (built from models.json)
backend/photo-check/models/
backend/photo-check/__pycache__/
