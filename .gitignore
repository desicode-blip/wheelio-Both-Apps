# Flutter / Dart
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
*.iml
.idea/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Generated.xcconfig
**/android/local.properties

# Local environment configuration and private keys
**/env/*.json
!**/env/*.example.json
# Apple push/signing private keys stay outside the source handoff.
*.p8
*.p12
.DS_Store

# Xcode build output and per-user Xcode state (not source)
**/DerivedData/
**/.derived-data-log-*
**/xcuserdata/
*.xcuserstate

# Local caches
.cache/

# Temporary rendered PDF review pages (final reports live in output/pdf/).
tmp/pdfs/

# Node dependencies and generated output
node_modules/
out/
.pnpm-store/
*.tsbuildinfo
.env*
!.env.example
.dev.vars
!.dev.vars.example

# Firebase runtime output and local build settings
.firebase/
*-debug.log
firestore-debug.log
ui-debug.log
firebase.local.json
.secret.local
apps/flutter/**/env/firebase.json

# App lockfiles are tracked for reproducible releases.
!apps/flutter/customer/pubspec.lock
!apps/flutter/captain/pubspec.lock

# Downloaded, checksum-verified private photo service models (built from models.json)
backend/photo-check/models/
backend/photo-check/__pycache__/

# Private Android upload signing is local-only.
**/*.jks
**/*.keystore
**/key.properties
**/*upload.properties
**/*.hprof

# Apple push-notification private signing keys must never enter source control.
**/*.p8
