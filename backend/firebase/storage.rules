rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null && (!firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) || !firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.keys().hasAny(['deletionStatus'])); }
    function order(orderId) { return firestore.get(/databases/(default)/documents/orders/$(orderId)).data; }
    function photo() { return request.resource.size > 0 && request.resource.size <= 8 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)'); }
    match /identity/{uid}/{orderId}/{file} {
      function currentAttempt() {
        let account = firestore.get(/databases/(default)/documents/users/$(uid)).data;
        let job = order(orderId);
        return !account.keys().hasAny(['deletionStatus']) && job.captainId == uid && job.status == 'onTheWay'
          && job.identityCaptureExpiresAt > request.time && file == job.identityCaptureSession + '.jpg';
      }
      // One immutable server-issued attempt. Customers cannot read Captain selfies.
      allow create: if resource == null && request.auth != null && uid == request.auth.uid && photo() && currentAttempt();
      allow read, update, delete: if false;
    }
    match /profiles/{uid}/{file} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn() && uid == request.auth.uid && file.matches('(customer|captain)\\.jpg') && photo();
      allow delete: if false;
    }
    match /orders/{orderId}/problems/{file} {
      allow read: if signedIn() && (order(orderId).customerId == request.auth.uid || order(orderId).captainId == request.auth.uid);
      allow create, update: if signedIn() && order(orderId).customerId == request.auth.uid && order(orderId).status in ['photosReady', 'approved']
        && file in [request.auth.uid + '_0.jpg', request.auth.uid + '_1.jpg', request.auth.uid + '_2.jpg'] && photo();
      allow delete: if false;
    }
    match /orders/{orderId}/dispute_response/{file} {
      allow read: if signedIn() && (order(orderId).customerId == request.auth.uid || order(orderId).captainId == request.auth.uid);
      allow create, update: if signedIn() && order(orderId).captainId == request.auth.uid && order(orderId).status == 'disputed'
        && file == request.auth.uid + '.m4a' && request.resource.size > 0 && request.resource.size <= 20 * 1024 * 1024 && request.resource.contentType.matches('audio/(mp4|aac)');
      allow delete: if false;
    }
    match /orders/{orderId}/customer/{file} {
      allow read: if signedIn() && (order(orderId).customerId == request.auth.uid || order(orderId).captainId == request.auth.uid);
      allow create, update: if signedIn() && order(orderId).customerId == request.auth.uid && order(orderId).status == 'pendingPayment'
        && ((file.matches('(front|back|left|right)\\.jpg') && photo())
          || (request.resource.size > 0 && request.resource.size <= 20 * 1024 * 1024
            && ((file == 'note_audio' && request.resource.contentType.matches('audio/(mp4|aac)'))
              || (file in ['note_video', 'vehicle'] && request.resource.contentType.matches('video/(mp4|quicktime)')))));
      allow delete: if false;
    }
    match /orders/{orderId}/{captainId}/{file} {
      allow read: if signedIn() && (order(orderId).customerId == request.auth.uid || order(orderId).captainId == request.auth.uid);
      allow create, update: if signedIn() && captainId == request.auth.uid && order(orderId).captainId == request.auth.uid && photo()
        && ((order(orderId).status == 'onTheWay' && file.matches('before_[0-3]\\.jpg'))
          || (order(orderId).status == 'washing' && file.matches('after_[0-3]\\.jpg')));
      allow delete: if false;
    }
    match /kyc/{uid}/{file} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn() && uid == request.auth.uid && file.matches('(aadhaar|selfie|bank)\\.jpg') && photo()
        && firestore.get(/databases/(default)/documents/captains/$(uid)).data.kycStatus in ['notSubmitted', 'changesRequested'];
      allow delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
