rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Live model: orders, jobOffers, earnings, payments, refunds and their
    // events/tracking are server-owned. Users can only read their own records.
    // Captain approval is never a client-writable profile field.
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function text(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function timestamps(data) { return data.createdAt == request.time && data.updatedAt == request.time; }
    function bookingParty(orderId) {
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return request.auth != null && (order.customerId == request.auth.uid || order.captainId == request.auth.uid);
    }
    match /config/operations { allow read: if true; allow write: if false; }
    match /orders/{orderId} {
      allow read: if request.auth != null && (resource.data.customerId == request.auth.uid || resource.data.captainId == request.auth.uid);
      allow write: if false;
      match /events/{event} { allow read: if bookingParty(orderId); allow write: if false; }
      match /tracking/{tracking} { allow read: if bookingParty(orderId); allow write: if false; }
    }
    match /captains/{uid} { allow read: if owner(uid); allow write: if false; }
    match /jobOffers/{offerId} { allow read: if request.auth != null && resource.data.captainId == request.auth.uid; allow write: if false; }
    match /earnings/{orderId} { allow read: if request.auth != null && resource.data.captainId == request.auth.uid; allow write: if false; }
    match /payments/{orderId} { allow read: if request.auth != null && resource.data.customerId == request.auth.uid; allow write: if false; }
    match /refunds/{orderId} { allow read: if request.auth != null && resource.data.customerId == request.auth.uid; allow write: if false; }
    match /supportTickets/{ticketId} { allow read: if request.auth != null && resource.data.customerId == request.auth.uid; allow write: if false; }

    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'createdAt', 'updatedAt'])
        && text(request.resource.data.name, 0, 80)
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.phone == request.auth.token.get('phone_number', '')
        && timestamps(request.resource.data);
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && text(request.resource.data.name, 2, 80)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /washRequests/{id} {
      allow read: if request.auth != null && resource.data.customerId == request.auth.uid;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasOnly([
          'customerId', 'vehicleType', 'registration', 'society', 'parking', 'washType',
          'preferredDate', 'timeWindow', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.vehicleType in ['bike', 'hatchback', 'sedan', 'suv']
        && request.resource.data.registration is string
        && request.resource.data.registration.matches('^[A-Z0-9]{6,12}$')
        && text(request.resource.data.society, 2, 120)
        && text(request.resource.data.parking, 2, 120)
        && text(request.resource.data.notes, 0, 500)
        && request.resource.data.washType in ['dryDusting', 'wetOutside']
        && request.resource.data.preferredDate is string
        && request.resource.data.preferredDate.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && request.resource.data.timeWindow in ['6–8 AM', '8–10 AM', '10 AM–12 PM', '12–2 PM', '2–4 PM', '4–6 PM']
        && request.resource.data.status == 'requested'
        && timestamps(request.resource.data);
      allow update: if request.auth != null && resource.data.customerId == request.auth.uid
        && resource.data.status == 'requested' && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /captainApplications/{uid} {
      allow read: if owner(uid);
      function validApplication(data) {
        return text(data.name, 2, 80) && text(data.area, 2, 120)
          && data.phone is string && data.phone.matches('^[6-9][0-9]{9}$');
      }
      allow create: if owner(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasOnly(['name', 'phone', 'area', 'status', 'createdAt', 'updatedAt'])
        && validApplication(request.resource.data)
        && request.resource.data.status == 'submitted'
        && timestamps(request.resource.data);
      allow update: if owner(uid) && resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'area', 'updatedAt'])
        && validApplication(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Pricing, payments, payouts, KYC approval and job state need trusted server code.
    // Client access stays closed until those integrations exist.
    match /{document=**} { allow read, write: if false; }
  }
}
