{
  "name": "wheelio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node apps/flutter/tool/workspace.mjs dev customer",
    "dev:captain": "node apps/flutter/tool/workspace.mjs dev captain",
    "build": "node apps/flutter/tool/build-firebase.mjs",
    "start": "node apps/flutter/tool/serve.mjs build/firebase-hosting 8083",
    "typecheck": "node apps/flutter/tool/workspace.mjs analyze",
    "test": "node apps/flutter/tool/workspace.mjs test",
    "preview": "node apps/flutter/tool/serve.mjs build/firebase-hosting 8083",
    "deploy": "firebase deploy --only hosting",
    "firebase:build": "node apps/flutter/tool/build-firebase.mjs",
    "firebase:preview": "firebase emulators:start --only hosting",
    "firebase:test": "firebase emulators:exec --project demo-wheelio --only firestore,auth,storage \"npm --prefix backend/firebase test\""
  }
}
