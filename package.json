{
  "name": "wheelio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @wheelio/web dev",
    "build": "pnpm --filter @wheelio/web build",
    "start": "pnpm --filter @wheelio/web start",
    "typecheck": "pnpm --filter @wheelio/web typecheck",
    "preview": "pnpm --filter @wheelio/web preview",
    "deploy": "pnpm --filter @wheelio/web deploy",
    "upload": "pnpm --filter @wheelio/web upload",
    "cf-typegen": "pnpm --filter @wheelio/web cf-typegen",
    "db:generate": "pnpm --filter @wheelio/web db:generate",
    "db:migrate": "pnpm --filter @wheelio/web db:migrate"
  }
}
